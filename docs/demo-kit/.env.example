# PayScope standalone demo-kit configuration.
# Copy this file to .env. These values target the deployed API from your laptop.
# Keep this project in Razorpay TEST mode only.

# Deployed PayScope API origin. Do not use localhost unless you intentionally run the backend locally.
PAYSCOPE_DEMO_API_URL=https://temp.coslynx.com

# Must exactly match the deployed backend's test webhook secret.
PAYSCOPE_DEMO_WEBHOOK_SECRET=replace_with_test_webhook_secret

# Organization UUID returned by the deployed /api/mvp/health endpoint.
PAYSCOPE_DEMO_ORGANIZATION_ID=replace_with_demo_organization_uuid
PAYSCOPE_DEMO_RAZORPAY_ENVIRONMENT=test

# Synthetic sequence pacing. 4000ms gives the production queue time to process between events.
PAYSCOPE_DEMO_PAUSE_MS=4000
# Optional: set a fixed value to intentionally replay one rehearsal. Leave unset for a fresh run.
# PAYSCOPE_DEMO_RUN_ID=demo-rehearsal-01

# Optional: used only by the real-enrichment commands documented in README.md.
# These must belong to the same Razorpay TEST account configured on the deployed backend.
# They are used for read-only GET /v1/payments/:id calls and are never sent to PayScope.
# PAYSCOPE_DEMO_RAZORPAY_KEY_ID=rzp_test_replace_me
# PAYSCOPE_DEMO_RAZORPAY_KEY_SECRET=replace_with_test_key_secret

# Optional real Razorpay Test payment slots. If filled, `npm run start` uses
# these automatically; leaving them blank keeps the synthetic rehearsal path.
# FAILED must have status=failed. RELATED should be another failed payment or
# the same payment when demonstrating repeated/correlated evidence.
# PAYSCOPE_DEMO_FAILED_PAYMENT_ID=pay_...
# PAYSCOPE_DEMO_RELATED_PAYMENT_ID=pay_...
# CAPTURED must have status=captured and be the payment completed through the
# PayScope-generated Payment Link. Its reference is required for reconciliation.
# PAYSCOPE_DEMO_CAPTURED_PAYMENT_ID=pay_...
# PAYSCOPE_DEMO_PAYMENT_LINK_REFERENCE=ps_...

# Optional baseline assertion. Set to 1 for a clean organization, or increase it when rehearsing repeatedly.
PAYSCOPE_DEMO_MIN_INCIDENTS=1
