# PayScope production VPS configuration. Copy to backend/.env on the VPS only.
# Never commit that file or place any of these values in Vercel.

PORT=25655
NODE_ENV=production
PAYSCOPE_PIPELINE_ENABLED=true
PAYSCOPE_DIRECT_EXECUTION_ENABLED=false
PAYSCOPE_WORKER_ID=payscope-production-1
TRUST_PROXY=true
CORS_ORIGINS=https://your-project.vercel.app

RAZORPAY_ENVIRONMENT=live
RAZORPAY_KEY_ID=rzp_live_replace_me
RAZORPAY_KEY_SECRET=replace_with_live_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_live_webhook_secret

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key
PAYSCOPE_ORGANIZATION_ID=replace_with_live_merchant_organization_uuid
PAYSCOPE_INTEGRATION_ORGANIZATION_ID=replace_with_separate_integration_organization_uuid

MESH_API_KEY=replace_with_mesh_api_key
MESH_MODEL=openai/gpt-4o-mini-2024-07-18

SMTP_HOST=smtp.your-verified-domain.example
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace_with_smtp_user
SMTP_PASS=replace_with_smtp_password
SMTP_POOL_MAX_CONNECTIONS=2
MAIL_FROM="PayScope <payments@your-verified-domain.example>"
PAYSCOPE_EMAIL_ENCRYPTION_KEY=replace_with_base64_32_byte_key

PAYSCOPE_ENRICHMENT_TIMEOUT_MS=5000
PAYSCOPE_MODEL_TIMEOUT_MS=8000
PAYSCOPE_QUEUE_LOCK_TIMEOUT_MS=30000
PAYSCOPE_RECOVERY_WINDOW_MS=259200000
PAYSCOPE_EXECUTION_POLL_INTERVAL_MS=2000
