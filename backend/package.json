{
  "name": "payscope-api",
  "version": "1.0.0",
  "description": "PayScope — Razorpay payment incident ingestion, investigation, and policy-driven operations API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test:smoke": "npm run build && node scripts/smoke-test.js",
    "test:contracts": "npm run build && node scripts/contracts-test.js",
    "test:schema": "node scripts/schema-test.js",
    "test:webhook-intake": "npm run build && node scripts/webhook-intake-test.js",
    "test:queue": "npm run build && node scripts/queue-worker-test.js",
    "test:enrichment": "npm run build && node scripts/enrichment-test.js",
    "test:correlation": "npm run build && node scripts/correlation-test.js",
    "test:job-processor": "npm run build && node scripts/job-processor-test.js",
    "test:model-provider": "npm run build && node scripts/model-provider-test.js",
    "test:agents": "npm run build && node scripts/agent-pipeline-test.js",
    "test:investigation-runner": "npm run build && node scripts/investigation-runner-test.js",
    "test:agentic-webhook": "npm run build && node scripts/agentic-webhook-intake-test.js",
    "test:mvp-api": "npm run build && node scripts/mvp-api-test.js",
    "test:dashboard": "npm run build && node scripts/dashboard-repository-test.js",
    "test:evaluation": "npm run build && node scripts/evaluation-metrics-test.js",
    "test:attribution": "npm run build && node scripts/recovery-attribution-test.js",
    "test:integration-scope": "node scripts/integration-organization-test.js",
    "test:fixtures": "npm run build && node scripts/fixture-schema-test.js && node scripts/phase2-fixtures-test.js",
    "test:phase5-fixtures": "npm run build && node scripts/phase5-fixtures-test.js",
    "run:evaluation": "npm run build && node scripts/run-fixture-evaluation.js",
    "test:database-client": "npm run build && node scripts/database-client-test.js",
    "test:rls-integration": "npm run build && node scripts/rls-integration-test.js",
    "test:durable-intake": "npm run build && node scripts/durable-intake-integration-test.js",
    "test:terminal-cancellation": "npm run build && node scripts/terminal-cancellation-integration-test.js",
    "test:queue-lease": "npm run build && node scripts/queue-lease-integration-test.js",
    "test:queue-integrity": "npm run build && node scripts/queue-event-integrity-integration-test.js",
    "test:outreach-stopping-rules": "npm run build && node scripts/outreach-stopping-rule-integration-test.js",
    "test:cors": "npm run build && node scripts/cors-preflight-test.js",
    "test:risk-tools": "npm run build && node scripts/risk-tools-integration-test.js",
    "test:attribution-integration": "npm run build && node scripts/recovery-attribution-integration-test.js",
    "test:audit-integrity": "npm run build && node scripts/audit-integrity-integration-test.js",
    "test:audit-lifecycle": "npm run build && node scripts/audit-lifecycle-integration-test.js",
    "test:phase3": "npm run build && node scripts/phase3-pipeline-test.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ws": "^8.18.0",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.3",
    "typescript": "^5.5.2"
  },
  "engines": {
    "node": ">=20"
  }
}
