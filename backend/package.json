{
  "name": "payscope-api",
  "version": "1.0.0",
  "description": "PayScope — Razorpay payment incident ingestion, investigation, and policy-driven operations API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test:smoke": "npm run build && node scripts/smoke-test.js",
    "test:contracts": "npm run build && node scripts/contracts-test.js",
    "test:schema": "node scripts/schema-test.js",
    "test:webhook-intake": "npm run build && node scripts/webhook-intake-test.js",
    "test:queue": "npm run build && node scripts/queue-worker-test.js",
    "test:enrichment": "npm run build && node scripts/enrichment-test.js",
    "test:correlation": "npm run build && node scripts/correlation-test.js",
    "test:job-processor": "npm run build && node scripts/job-processor-test.js",
    "test:model-provider": "npm run build && node scripts/model-provider-test.js",
    "test:agents": "npm run build && node scripts/agent-pipeline-test.js",
    "test:investigation-runner": "npm run build && node scripts/investigation-runner-test.js",
    "test:agentic-webhook": "npm run build && node scripts/agentic-webhook-intake-test.js",
    "test:mvp-api": "npm run build && node scripts/mvp-api-test.js",
    "test:communications": "npm run build && node scripts/communications-test.js",
    "test:evaluation": "npm run build && node scripts/evaluation-metrics-test.js",
    "test:database-client": "npm run build && node scripts/database-client-test.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ws": "^8.18.0",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.3",
    "typescript": "^5.5.2"
  },
  "engines": {
    "node": ">=20"
  }
}
