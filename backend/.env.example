# PayScope API — Environment Template
# Copy to .env and fill for local or Vercel. Never commit .env.
PORT=25655
NODE_ENV=production

# API access for the PayScope dashboard — must match frontend VITE_API_ACCESS_TOKEN
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_ACCESS_TOKEN=replace_with_a_long_random_token_64_hex_chars
CORS_ORIGINS=https://payscope-ai.vercel.app,https://payscope.vercel.app,https://payscope-frontend.vercel.app
# Optional deployment-provided frontend origin (also reads VERCEL_URL automatically):
# FRONTEND_URL=https://your-frontend.example.com
REQUIRE_API_AUTH=true

# Public HTTPS origin used to compose the Razorpay webhook URL
# Local: http://localhost:25655
# Vercel: https://payscope-api.vercel.app
PAYMENT_OPS_PUBLIC_URL=https://temp.coslynx.com

# Razorpay — Test Mode first. Use rzp_test_* for local, live keys only in prod env.
RAZORPAY_ENVIRONMENT=test
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me_test_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_a_32_char_random_secret_at_least_32_hex

# Supabase — https://oheegffhhtdudlbgrtso.supabase.co
# Get from Supabase Dashboard → Project Settings → API Keys
SUPABASE_URL=https://oheegffhhtdudlbgrtso.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_replace_me_get_from_dashboard

# Optional AI — leave empty for rules-v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
