# PayScope backend — Test Mode MVP
# Copy to backend/.env. This file is safe to commit; .env is not.

PORT=25655
NODE_ENV=development
PAYSCOPE_MVP_PIPELINE=false

# Comma-separated origins. Use your exact Vercel production URL on the VPS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUST_PROXY=false

# Razorpay Test Mode only. The backend rejects any other environment.
RAZORPAY_ENVIRONMENT=test
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_with_test_mode_key_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_webhook_secret

# Supabase service-role credentials belong only on the VPS/backend.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key

# Required before changing PAYSCOPE_MVP_PIPELINE to true. Seed this UUID in
# payscope_organizations after applying the canonical migration.
PAYSCOPE_DEMO_ORGANIZATION_ID=replace_with_seeded_organization_uuid
PAYSCOPE_WORKER_ID=payscope-local-1

# Required only to approve a proposal in the demo UI. Keep this VPS-only value
# out of Vercel and type it into the UI for each review session; it is never
# stored in the browser. Approval produces a simulated audit record only.
PAYSCOPE_DEMO_APPROVAL_TOKEN=replace_with_a_random_32_plus_character_token
PAYSCOPE_DEMO_OPERATOR_ID=demo-operator

# Optional: without a Mesh key, investigations are safely recorded as
# failed and escalated for human review. No proposal is created.
MESH_API_KEY=
# Mesh model IDs are provider-qualified. This snapshot honors strict structured output.
MESH_MODEL=openai/gpt-4o-mini-2024-07-18

# Needed only by `npm run run:evaluation`; keep this VPS-only. The report is a
# signed synthetic-fixture benchmark, not a merchant-performance metric.
PAYSCOPE_FIXTURE_SIGNING_SECRET=replace_with_a_random_32_plus_character_secret
# Optional: development (default) or held_out. A held-out version records once.
# PAYSCOPE_EVALUATION_SPLIT=development

# Optional bounded runtime overrides (defaults are already safe for the MVP).
# PAYSCOPE_ENRICHMENT_TIMEOUT_MS=5000
# PAYSCOPE_MODEL_TIMEOUT_MS=8000
# PAYSCOPE_QUEUE_LOCK_TIMEOUT_MS=30000
# PAYSCOPE_RECOVERY_WINDOW_MS=259200000
