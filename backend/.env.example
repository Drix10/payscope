# PayScope API — Razorpay payment operations
PORT=25655
NODE_ENV=development

# API access for the dashboard. Never place Razorpay secrets in the frontend.
API_ACCESS_TOKEN=replace_with_a_long_random_token
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
REQUIRE_API_AUTH=false

# Public HTTPS origin used to compose the Razorpay webhook URL.
PAYMENT_OPS_PUBLIC_URL=https://your-domain.example

# Razorpay Test Mode first. Keep live credentials in a separate deployment environment.
RAZORPAY_ENVIRONMENT=test
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_with_a_32_character_random_secret

# Required for durable incident history and live mode.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_me

# Optional structured investigation provider. Without this, the app uses its
# transparent rules-based investigator and labels the run accordingly.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
