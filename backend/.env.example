# PayScope backend — autonomous payment operations
# Copy to backend/.env. This file is safe to commit; .env is not.

PORT=25655
NODE_ENV=production
PAYSCOPE_PIPELINE_ENABLED=true
# Enables immutable Razorpay Payment Link + Nodemailer email commands after
# migration 202608230009 has been applied and a recipient vault is seeded.
PAYSCOPE_DIRECT_EXECUTION_ENABLED=false

# Comma-separated origins. Use your exact Vercel production URL on the VPS.
CORS_ORIGINS=https://your-project.vercel.app
# Set true only when the VPS is behind one trusted reverse proxy.
TRUST_PROXY=true

# Razorpay read/write credentials. Direct execution currently creates Payment
# Links only; Razorpay's own SMS/email notification is disabled per command.
RAZORPAY_ENVIRONMENT=live
RAZORPAY_KEY_ID=rzp_live_replace_me
RAZORPAY_KEY_SECRET=replace_with_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_webhook_secret

# Supabase service-role credentials belong only on the VPS/backend.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key

# Required before changing PAYSCOPE_PIPELINE_ENABLED to true. Seed this UUID in
# payscope_organizations after applying the canonical migration.
PAYSCOPE_ORGANIZATION_ID=replace_with_seeded_organization_uuid
PAYSCOPE_WORKER_ID=payscope-production-1

# Hosted integration fixtures must use a stable, separate organization, never
# the visible merchant tenant. Append-only audit evidence prevents cleanup;
# replace a compromised fixture tenant instead of reusing it.
PAYSCOPE_INTEGRATION_ORGANIZATION_ID=replace_with_a_separate_seeded_integration_organization_uuid

# Without a Mesh key, investigations become an audited autonomous no-action
# outcome. No proposal is created and no browser intervention is required.
MESH_API_KEY=
# Mesh model IDs are provider-qualified. This snapshot honors strict structured output.
MESH_MODEL=openai/gpt-4o-mini-2024-07-18

# Email-only outreach MVP. Nodemailer connects to your transactional SMTP
# relay; use a verified sender domain with SPF, DKIM, and DMARC records.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace_with_smtp_user
SMTP_PASS=replace_with_smtp_password
SMTP_POOL_MAX_CONNECTIONS=2
MAIL_FROM="PayScope <payments@example.com>"

# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Never rotate this key without first re-encrypting the recipient vault.
PAYSCOPE_EMAIL_ENCRYPTION_KEY=replace_with_base64_32_byte_key

# VPS-only input for `npm run recipient:upsert`; do not leave these in the
# deployed service environment after the one-off encrypted-vault write.
# PAYSCOPE_RECIPIENT_CUSTOMER_ID=cust_replace_me
# PAYSCOPE_RECIPIENT_EMAIL=customer@example.com
# PAYSCOPE_RECIPIENT_EMAIL_CONSENT=true

# Needed only by `npm run run:evaluation`; keep this VPS-only. The report is a
# signed synthetic-fixture benchmark, not a merchant-performance metric.
PAYSCOPE_FIXTURE_SIGNING_SECRET=replace_with_a_random_32_plus_character_secret
# Optional: development (default) or held_out. A held-out version records once.
# PAYSCOPE_EVALUATION_SPLIT=development

# Optional bounded runtime overrides (defaults are already safe for the MVP).
# PAYSCOPE_ENRICHMENT_TIMEOUT_MS=5000
# PAYSCOPE_MODEL_TIMEOUT_MS=8000
# PAYSCOPE_QUEUE_LOCK_TIMEOUT_MS=30000
# PAYSCOPE_RECOVERY_WINDOW_MS=259200000
# PAYSCOPE_EXECUTION_POLL_INTERVAL_MS=2000
