# PayScope frontend — public Vercel build values only.
# Copy to frontend/.env. Every VITE_* value is embedded in the browser bundle.

VITE_API_BASE_URL=https://api.your-domain.example
VITE_API_TIMEOUT_MS=20000

# Do not add API tokens, Razorpay keys, Supabase keys, Mesh keys, or
# communication credentials here. The frontend intentionally has no browser
# credentials and talks only to the read-only /api/mvp endpoints.
